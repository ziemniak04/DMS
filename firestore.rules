rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is the owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to check if user is a doctor
    function isDoctor() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'doctor';
    }

    // Helper function to check if user is a patient
    function isPatient() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'patient';
    }

    // Users collection
    match /users/{userId} {
      // Allow users to read their own document
      allow read: if isOwner(userId);

      // Allow users to create their own document during registration
      allow create: if isOwner(userId) &&
                      request.resource.data.id == request.auth.uid &&
                      request.resource.data.email == request.auth.token.email;

      // Allow users to update their own document
      allow update: if isOwner(userId);

      // Allow users to delete their own document
      allow delete: if isOwner(userId);

      // Allow doctors to read patient documents
      allow read: if isDoctor() && resource.data.role == 'patient';

      // Allow doctors to update patient's doctorId field
      allow update: if isDoctor() &&
                      resource.data.role == 'patient' &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['doctorId']);
    }

    // Glucose readings collection
    match /glucoseReadings/{readingId} {
      // Allow users to read their own readings
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Allow users to create their own readings
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;

      // Allow users to update their own readings
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Allow users to delete their own readings
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Allow doctors to read their patients' readings
      allow read: if isDoctor() &&
                    get(/databases/$(database)/documents/users/$(resource.data.userId)).data.doctorId == request.auth.uid;
    }

    // Diabetes events collection
    match /diabetesEvents/{eventId} {
      // Allow users to read their own events
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Allow users to create their own events
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;

      // Allow users to update their own events
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Allow users to delete their own events
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Allow doctors to read their patients' events
      allow read: if isDoctor() &&
                    get(/databases/$(database)/documents/users/$(resource.data.userId)).data.doctorId == request.auth.uid;
    }
  }
}
